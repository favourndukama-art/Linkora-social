# HTTP port and bind address.
PORT=3003
HOST=0.0.0.0

# S3-compatible object storage (Cloudflare R2 or AWS S3).
MEDIA_BUCKET=linkora-media
MEDIA_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=

# Maximum upload size in megabytes.
MAX_FILE_SIZE_MB=10

# Base URL used to serve uploaded objects. Private object URLs are signed.
CDN_BASE_URL=https://cdn.example.com
CDN_SIGNING_SECRET=

# Runtime environment.
NODE_ENV=development

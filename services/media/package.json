{
  "name": "@linkora/media",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Media processing service for Linkora — image upload, resize, and CDN delivery",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",

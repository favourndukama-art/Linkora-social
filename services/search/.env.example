# Bind address and HTTP port for the search API.
HOST=0.0.0.0
PORT=3004

# PostgreSQL and Redis connections. Use service names when running in Compose.
DATABASE_URL=postgresql://linkora:linkora@localhost:5432/linkora
REDIS_URL=redis://localhost:6379

# Logging and runtime settings.
LOG_LEVEL=info
NODE_ENV=development

# Optional OpenTelemetry OTLP HTTP exporter endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
